# Copie ce fichier vers .env puis renseigne ta connexion PostgreSQL
# Exemple local : postgres://postgres:monmotdepasse@localhost:5432/todolist
# Exemple Neon/Supabase : postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=postgres://postgres:monmotdepasse@localhost:5432/todolist

# Mettre "true" si la base est distante (SSL requis)
DB_SSL=false

PORT=3000